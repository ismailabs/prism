{
  "name": "prism-finance",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "node scripts/finance-db-test.mjs",
    "test:platform-db": "node scripts/platform-db-test.mjs",
    "test:e2e": "playwright test",
    "test:auth-security": "playwright test --config auth-security.playwright.config.ts",
    "test:pwa": "playwright test --config pwa.playwright.config.ts",
    "test:pwa-review": "node scripts/pwa-review-probes.mjs",
    "test:localization": "node scripts/localization-audit.mjs",
    "test:restore": "node scripts/phase7-restore-test.mjs",
    "test:release-package": "node scripts/phase7-release-package.mjs",
    "test:responsive": "node scripts/verify-responsive.mjs",
    "test:foundations-db": "node scripts/foundations-db-test.mjs",
    "test:period-db": "node scripts/period-db-test.mjs",
    "test:postgres": "node scripts/real-postgres-test.mjs",
    "test:ledger-db": "node scripts/ledger-db-test.mjs",
    "ledger:dry-run": "node scripts/ledger-dry-run.mjs",
    "ledger:preview": "node scripts/ledger-preview.mjs",
    "test:ledger-preview": "node scripts/ledger-preview-test.mjs",
    "test:planning-db": "node scripts/planning-db-test.mjs",
    "test:integration-db": "node scripts/integration-db-test.mjs",
    "test:integration-review": "node scripts/integration-review-probes.mjs",
    "test:goal-actions-db": "node scripts/goal-actions-db-test.mjs",
    "test:actions-db": "node scripts/actions-db-test.mjs",
    "test:actions-native": "node scripts/actions-native-test.mjs",
    "test:actions-review": "node scripts/phase5-review-probes.mjs",
    "test:intelligence-db": "node scripts/intelligence-db-test.mjs",
    "test:intelligence-native": "node scripts/intelligence-db-test.mjs --native",
    "test:ledger-review": "node scripts/phase2-review-probes.mjs",
    "test:deletion-security": "node scripts/deletion-security-test.mjs",
    "test:intelligence-review": "node scripts/phase6-review-probes.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@supabase/supabase-js": "2.116.0",
    "@tanstack/react-query": "5.103.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "13.4.0",
    "i18next": "26.4.2",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.14",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "pg": "8.16.3",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
