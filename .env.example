# Use an isolated development project. Never copy production credentials here.
VITE_SUPABASE_URL=https://YOUR_DEVELOPMENT_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Public key only. Enable the matching Turnstile secret in Supabase Auth before
# public registration. Never place the CAPTCHA secret or SMTP credentials here.
VITE_TURNSTILE_SITE_KEY=
# Server defaults to the free, no-key Frankfurter provider. Opt in to a keyed
# provider only after independently verifying its plan has no possible charges.
EXCHANGE_RATE_PROVIDER=frankfurter
# Used only with EXCHANGE_RATE_PROVIDER=exchangerate-api; never use a VITE_ prefix.
EXCHANGE_RATE_API_KEY=
# Currency/language defaults currently live in the store and database, not env vars.
