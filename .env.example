# Use an isolated development project. Never copy production credentials here.
VITE_SUPABASE_URL=https://YOUR_DEVELOPMENT_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Optional server-only rate provider key; the server has a public-provider fallback.
EXCHANGE_RATE_API_KEY=
# Currency/language defaults currently live in the store and database, not env vars.
